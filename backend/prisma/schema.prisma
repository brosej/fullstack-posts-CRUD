generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Post {
  id            Int      @id @default(autoincrement()) @map("Id")
  nombre        String   @db.NVarChar(255) @map("Nombre")
  descripcion   String   @db.NVarChar(Max) @map("Descripcion")
  resumen       String?  @db.NVarChar(500) @map("Resumen")
  fechaCreacion DateTime @default(now()) @map("FechaCreacion")

  @@map("Posts")
}